diff --git a/owl/public/mojom/agent_gate.mojom b/owl/public/mojom/agent_gate.mojom
new file mode 100644
index 0000000000000..7f91d7036c8f5
--- /dev/null
+++ b/owl/public/mojom/agent_gate.mojom
@@ -0,0 +1,57 @@
+// Agent action gate for Owl host-side safety controls.
+// MVP should deny most actions and only allow constrained reads by default.
+
+module owl.mojom;
+
+import "owl/public/mojom/owl_host.mojom";
+
+struct AccessibilityNode {
+  string role;
+  string name;
+  uint32 id;
+  bool is_focusable;
+};
+
+struct ActionContext {
+  uint64 webview_id;
+  string page_url;
+  string title;
+  array<AccessibilityNode> accessibility_snapshot;
+};
+
+struct TaskPolicy {
+  bool read_only = true;
+  bool allow_networked_actions = false;
+  bool allow_downloads = false;
+  bool allow_form_submission = false;
+  bool allow_clipboard = false;
+};
+
+struct ActionProposal {
+  uint64 webview_id;
+  string action_name;
+  string details;
+};
+
+struct ActionDecision {
+  bool approved;
+  string reason;
+};
+
+struct AgentTaskId {
+  uint64 id;
+};
+
+interface AgentGate {
+  [MinVersion=1]
+  StartLoggedOutTask(uint64 webview_id, TaskPolicy policy) => (AgentTaskId task_id);
+
+  [MinVersion=1]
+  CaptureContext(uint64 webview_id) => (ActionContext context);
+
+  [MinVersion=1]
+  RequestAction(ActionProposal proposal) => (ActionDecision decision);
+
+  [MinVersion=1]
+  EndTask(AgentTaskId task_id);
+};

diff --git a/owl/public/mojom/owl_host.mojom b/owl/public/mojom/owl_host.mojom
new file mode 100644
index 0000000000000..fa32d2a5998b9
--- /dev/null
+++ b/owl/public/mojom/owl_host.mojom
@@ -0,0 +1,101 @@
+// Owl host service contracts for Windows MVP.
+// This is a minimal, versioned API surface.
+
+module owl.mojom;
+
+enum ProfileMode {
+  DEFAULT = 0,
+  LOGGED_OUT_EPHEMERAL = 1,
+};
+
+struct SessionParams {
+  string profile_path;
+  ProfileMode mode = DEFAULT;
+};
+
+struct ProfileParams {
+  string profile_path;
+  ProfileMode mode = DEFAULT;
+};
+
+struct WebViewParams {
+  uint64 parent_hwnd;
+  uint32 x;
+  uint32 y;
+  uint32 width;
+  uint32 height;
+  float scale_x;
+  float scale_y;
+  uint64 profile_id;
+};
+
+struct BoundsPx {
+  int32 x;
+  int32 y;
+  int32 width;
+  int32 height;
+};
+
+struct Rect {
+  BoundsPx bounds;
+  float scale_x;
+  float scale_y;
+};
+
+struct SessionHandle {
+  uint64 id;
+};
+
+struct ProfileId {
+  uint64 id;
+};
+
+struct WebViewId {
+  uint64 id;
+};
+
+interface OwlHost {
+  [MinVersion=1]
+  CreateSession(SessionParams params) => (SessionHandle session_id);
+
+  [MinVersion=1]
+  CreateProfile(ProfileParams params) => (ProfileId profile_id);
+
+  [MinVersion=1]
+  CreateWebView(WebViewParams params) => (WebViewId webview_id);
+
+  [MinVersion=1]
+  DestroyWebView(WebViewId webview_id);
+
+  [MinVersion=1]
+  Navigate(WebViewId webview_id, string url);
+
+  [MinVersion=1]
+  GoBack(WebViewId webview_id);
+
+  [MinVersion=1]
+  GoForward(WebViewId webview_id);
+
+  [MinVersion=1]
+  Reload(WebViewId webview_id);
+
+  [MinVersion=1]
+  SetVisible(WebViewId webview_id, bool visible);
+
+  [MinVersion=1]
+  Resize(WebViewId webview_id, Rect bounds);
+
+  [MinVersion=1]
+  GetDevToolsEndpoint(WebViewId webview_id) => (string endpoint);
+};

